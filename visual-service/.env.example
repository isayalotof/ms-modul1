# Service Configuration
SERVICE_NAME=visual-service
SERVICE_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# S3 Configuration (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=visual-storage
S3_REGION=us-east-1
S3_USE_SSL=False

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Image Generation Settings
DEFAULT_IMAGE_SIZE=1024x1024
MAX_IMAGE_SIZE=1792x1792
SUPPORTED_IMAGE_FORMATS=png,jpg,webp

# Chart Generation Settings
DEFAULT_CHART_DPI=300
DEFAULT_CHART_SIZE=800x600
MAX_CHART_SIZE=2400x1800

# Storage Settings
MAX_FILE_SIZE=50MB
FILE_EXPIRATION_DAYS=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Proxy Configuration (optional)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
